<template>
  <div class="page" style="flex-direction: column;">
    <block if="{{allBooks.length == 0 && moreBooks.length == 0}}">
      <img static src="/common/images/empty.png" style="position: absolute;left: 50px;top: 186px;width: 92px;height: 92px;" />
      <text static style="position: absolute;left: 0px;top: 289px;width: 192px;line-height: 42px;font-weight:bold;font-size:22px;color:white;text-align:center;">书架空空</text>
    </block>

    <list class="list" if="{{allBooks.length > 0 || moreBooks.length > 0}}">
      <list-item type="tip" if="{{showStorageWarning && isStorageLow && (!selectedCategory || displayMode !== 'category')}}" class="item" style="background-color: #ad0000;">
        <text style="color: white;font-size: 21px;">实际可用存储空间不足，将无法正常使用。</text>
      </list-item>
      
			<list-item type="search" class="item search-item" @click="openSearch" if="{{showSearchBar}}">
				<div class="search-content">
					<text class="search-placeholder">搜索...</text>
				</div>
			</list-item>

      <list-item type="back" if="{{(displayMode === 'category' && selectedCategory) || moreFolderOpen}}" class="item" @click="backToCategoryList" style="height: 72px;">
        <text class="itemtext">{{moreFolderOpen ? '← 返回书架' : '← 返回分类'}}</text>
      </list-item>

      <list-item for="{{visibleBooks}}" type="nook" class="item" @click="handleItemClick($item)">
        <div class="{{getContentClass($item)}}">
          <marquee if="{{shelfMarqueeEnabled && !$item.isCategory}}" scrollamount="22" class="itemtext" text-offset="25">{{$item.displayName || $item.name}}</marquee>
          <text else class="itemtext">{{$item.displayName || $item.name}}</text>
          
          <marquee if="{{shelfMarqueeEnabled && !$item.isCategory}}" scrollamount="40" text-offset="25" class="itemtext2">{{$item.subtitle}}</marquee>
          <text else class="itemtext2">{{$item.subtitle}}</text>
        </div>
      </list-item>

      <list-item type="pagination" class="pagination-container" if="{{totalPages > 1}}">
        <div class="pagination-controls">
          <img src="/common/images/pre.png" if="{{currentPage > 0}}" @click="prevPage" class="pagination-button" />
          <text class="pagination-text">{{currentPage + 1}} / {{totalPages}}</text>
          <img src="/common/images/next.png" if="{{currentPage < totalPages - 1}}" @click="nextPage" class="pagination-button" />
        </div>
      </list-item>
    </list>

    <img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 192px;height: 102px;" />
    <img static src="/common/images/more.png" @click="routerTo('more')" style="position: absolute;left: 59px;top: 418px;width: 72px;height: 72px;" />
    <text style="position: absolute;top: 16px;width: 192px;line-height: 32px;font-weight:bold;font-size:18px;color:rgba(255,255,255,0.6);text-align:center;">{{nowTime}}</text>
    <text static style="position: absolute;top: 36px;width: 192px;line-height: 42px;font-weight:bold;font-size:26px;color:white;text-align:center;">页屿</text>
  </div>
</template>

<script>
import router from '@system.router';
import bookStorage from '../../utils/bookStorage.js'
import storage from '../../utils/storage.js';
import chapterManager from '../../utils/chapterManager.js';
import device from '@system.device';
import file from '@system.file';
import prompt from '@system.prompt';
import runAsyncFunc from '../../utils/runAsyncFunc.js';
import { calculateStorageInfo, isStorageLow } from '../../utils/storageUtils.js';

export default {
  private: {
    nowTime: "00:00",
    timer: null,
		timeFormat: '24h',
    shelfStyle: 'list',
    isNavigating: false,
    allBooks: [],
    moreBooks: [],
    moreFolderOpen: false,
    visibleBooks: [],
    currentPage: 0,
    totalPages: 1,
    pageSize: 5,
    lastReadOnTop: true,
    shelfMarqueeEnabled: false,
    displayMode: 'all',
    categories: [],
    selectedCategory: null,
    categoryBooks: [],
    lastReadBook: null,
    homeProgressMode: 'book',
    showStorageWarning: true,
    isStorageLow: false,
    categoryPagination: false,
    currentModeList: [],
    refreshMode: 'onExit',
		showSearchBar: true,
    progressSubtitleCache: {},
    categoryCountCache: null,
    lastDeviceInfoTs: 0,
    storageInfoLoaded: false
  },
  updateTime() {
    const date = new Date();
		let hours = date.getHours();
		let minutes = date.getMinutes();
		if (this.timeFormat === '12h') {
			let ampm = hours >= 12 ? '下午' : '上午';
			hours = hours % 12;
			hours = hours ? hours : 12;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${ampm} ${hours}:${minutes}`;
		} else {
			hours = hours < 10 ? '0' + hours : hours;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${hours}:${minutes}`;
		}
  },
  onInit() {
		storage.get({
			key: 'EBOOK_TIME_FORMAT',
			success: (data) => {
				if(data) this.timeFormat = data;
				this.updateTime();
			},
			fail: () => {
				this.updateTime();
			}
		});
    this.timer = setInterval(() => { this.updateTime(); }, 1000);
    bookStorage.load();
  },
  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
    this.progressSubtitleCache = null;
    this.categoryCountCache = null;
    this.allBooks = null;
    this.moreBooks = null;
    this.visibleBooks = null;
    this.currentModeList = null;
    global.runGC();
  },
  onShow() {
    this.isNavigating = false;

    // 内置书由启动注入代码异步写盘，写完置回 false，这里等它落地后重读一次书架
    if (globalThis.__seedBusy__ === true) {
      const seedTimer = setInterval(() => {
        if (globalThis.__seedBusy__ !== true) {
          clearInterval(seedTimer);
          this.loadFileList();
        }
      }, 300);
    }
    const shouldRestoreCategory = globalThis.fromCategoryPage && globalThis.selectedCategory;
    const shouldRestoreHomePage = globalThis.fromHomePage && typeof globalThis.homePage === 'number';
    
    const categoryToRestore = shouldRestoreCategory ? globalThis.selectedCategory : null;
    const categoryPageToRestore = shouldRestoreCategory ? globalThis.categoryPage : null;
    const homePageToRestore = shouldRestoreHomePage ? globalThis.homePage : null;
    
    if (shouldRestoreCategory) {
      globalThis.fromCategoryPage = false;
      globalThis.selectedCategory = null;
      globalThis.categoryPage = null;
    }
    if (shouldRestoreHomePage) {
      globalThis.fromHomePage = false;
      globalThis.homePage = null;
    }
    
    if (!shouldRestoreHomePage && !shouldRestoreCategory) {
      this.currentPage = 0;
    }

    this.loadSettingsAndFiles().then(() => {
      const shouldRefresh = this.shouldRefreshShelf();
      
      const proceedToRender = () => {
        if (shouldRestoreCategory && categoryToRestore) {
          this.displayMode = 'category';
          this.selectedCategory = categoryToRestore;
          if (typeof categoryPageToRestore === 'number') this.currentPage = categoryPageToRestore;
          this.updateCategoryView();
        } else if (shouldRestoreHomePage && homePageToRestore !== null && this.displayMode === 'all') {
          this.loadPage(homePageToRestore);
        } else {
          if (this.displayMode === 'category') {
            this.updateCategoryView();
          } else {
            this.loadPage(this.currentPage);
          }
        }
        this.loadDeviceInfo();
      };

      if (shouldRefresh || this.allBooks.length === 0) {
        this.loadFileList().then(proceedToRender);
      } else {
        proceedToRender();
      }
    });
  },
  getStorage(key, defaultValue) {
    return new Promise((resolve) => {
      storage.get({
        key: key,
        success: (data) => resolve(data || defaultValue),
        fail: () => resolve(defaultValue)
      });
    });
  },
  async loadSettingsAndFiles() {
    const keys = [
      'EBOOK_SHELF_PAGE_SIZE', 'EBOOK_TOP_LAST_READ', 
      'EBOOK_SHELF_MARQUEE_ENABLED', 'EBOOK_HOME_DISPLAY_MODE', 'EBOOK_HOME_PROGRESS_MODE', 
      'EBOOK_SHOW_STORAGE_WARNING', 'EBOOK_CATEGORY_PAGINATION', 'EBOOK_SHELF_REFRESH_MODE',
      'EBOOK_HOME_SEARCH_ENABLED'
    ];
    const defaults = ['5', 'true', 'false', 'all', 'book', 'true', 'false', 'onExit', 'true'];
    
    const results = await Promise.all(keys.map((k, i) => this.getStorage(k, defaults[i])));
    
    this.pageSize = parseInt(results[0]);
    this.shelfStyle = 'list';
    this.lastReadOnTop = results[1] === 'true';
    this.shelfMarqueeEnabled = results[2] === 'true';
    this.displayMode = results[3];
    this.homeProgressMode = results[4];
    this.showStorageWarning = results[5] === 'true';
    this.categoryPagination = results[6] === 'true';
    this.refreshMode = results[7];
		this.showSearchBar = results[8] === 'true';
  },
  shouldRefreshShelf() {
    if (this.refreshMode === 'onEnter') return true;
    if (this.refreshMode === 'onExit') {
      if (globalThis.shouldRefreshShelf) {
        globalThis.shouldRefreshShelf = false;
        return true;
      }
    }
    return false;
  },
  async loadFileList() {
    this.allBooks = await bookStorage.getBooks();
    this.progressSubtitleCache = {};
    this.categoryCountCache = null;
    await this.repairOrphanNames();
    await this.syncChapterCounts();
    this.processBooks();

    if (this.displayMode === 'category') {
      this.updateCategories();
      this.updateCategoryView();
      if (this.moreFolderOpen) this.openMoreFolder();
    } else {
      this.currentModeList = this.withMoreFolder(this.allBooks);
      if (this.moreFolderOpen) this.openMoreFolder();
      else this.loadPage(this.currentPage);
    }
    global.runGC();
  },
  // 目录名泄漏成书名（8 位十六进制）或空白名的记录，不混在书架主列表里，
  // 统一收进「更多」文件夹，需要时再进去看。
  isOrphanName(name) {
    if (name === null || name === undefined) return true;
    const text = String(name).trim();
    if (!text) return true;
    return /^[0-9a-f]{8}$/i.test(text);
  },
  withMoreFolder(list) {
    if (!this.moreBooks || this.moreBooks.length === 0) return list;
    return list.concat([{ isFolder: true, name: '更多', bookCount: this.moreBooks.length }]);
  },
  // 历史遗留的异常记录：本地还有 book_info.json 的，把真名补回去，能自动回到书架。
  async repairOrphanNames() {
    if (!this.allBooks || this.allBooks.length === 0) return;
    const targets = [];
    for (let i = 0; i < this.allBooks.length && targets.length < 3; i++) {
      const book = this.allBooks[i];
      if (book && book.dirName && this.isOrphanName(book.name)) targets.push(book);
    }
    if (targets.length === 0) return;

    let changed = false;
    for (let i = 0; i < targets.length; i++) {
      const book = targets[i];
      try {
        const data = await runAsyncFunc(file.readText, { uri: `internal://files/books/${book.dirName}/book_info.json` });
        const info = JSON.parse(data.text);
        const realName = typeof info.name === 'string' ? info.name.trim() : '';
        if (realName && !this.isOrphanName(realName)) {
          book.name = realName;
          changed = true;
        }
      } catch (e) { }
    }
    if (changed) await bookStorage.updateBooks(this.allBooks);
  },
  openMoreFolder() {
    this.moreFolderOpen = true;
    this.selectedCategory = null;
    this.currentModeList = this.moreBooks || [];
    this.currentPage = 0;
    this.loadPage(0);
  },
  async hasBookContent(dirName) {
    if (!dirName) return false;
    try {
      await runAsyncFunc(file.access, { uri: `internal://files/books/${dirName}/lindex.txt` });
      return true;
    } catch (e) {
      return false;
    }
  },
  async syncChapterCounts() {
    if (!Array.isArray(this.allBooks) || this.allBooks.length === 0) return;

    const needCheckBooks = [];
    for (let i = 0; i < this.allBooks.length; i++) {
      const book = this.allBooks[i];
      if (!book || !book.dirName) continue;
      const storedCount = parseInt(book.chapterCount, 10) || 0;
      if (storedCount <= 0) needCheckBooks.push(book);
    }

    if (needCheckBooks.length === 0) return;

    const maxCheckCount = Math.min(3, needCheckBooks.length);
    let hasUpdates = false;

    for (let i = 0; i < maxCheckCount; i++) {
      const book = needCheckBooks[i];
      try {
        const actualCount = await chapterManager.getTotalChapters(book.dirName);
        if (actualCount > 0 && actualCount !== (parseInt(book.chapterCount, 10) || 0)) {
          book.chapterCount = actualCount;
          hasUpdates = true;
        }
      } catch (e) { }
    }

    if (hasUpdates) await bookStorage.updateBooks(this.allBooks);
  },
  processBooks() {
    // 先分流出异常记录，书架主列表只留正常书。
    const shelfBooks = [];
    const moreBooks = [];
    (this.allBooks || []).forEach(book => {
      if (!book) return;
      if (this.isOrphanName(book.name)) moreBooks.push(book);
      else shelfBooks.push(book);
    });
    this.allBooks = shelfBooks;
    this.moreBooks = moreBooks;
    this.moreBooks.forEach(book => {
      book.displayName = String(book.name || '').trim() || '未命名记录';
    });

    this.lastReadBook = null;
    if (this.lastReadOnTop && this.allBooks.length > 0) {
      let lastReadIndex = -1;
      let latestTimestamp = 0;
      this.allBooks.forEach((book, index) => {
        book.isLastRead = false;
        if (book.progress && book.progress.lastReadTimestamp > latestTimestamp) {
          latestTimestamp = book.progress.lastReadTimestamp;
          lastReadIndex = index;
        }
      });
      if (lastReadIndex > -1) {
        const lastReadBook = this.allBooks.splice(lastReadIndex, 1)[0];
        lastReadBook.isLastRead = true;
        this.allBooks.unshift(lastReadBook);
        this.lastReadBook = lastReadBook;
      }
    }
    this.allBooks.forEach(book => {
      book.hasRealCover = !!(book.hasCover && book.coverFileName);
    });
  },
  updateCategories() {
    const categorySet = new Set();
    let hasUncategorized = false;
    this.allBooks.forEach(book => {
      if (book.localCategory) categorySet.add(book.localCategory);
      else hasUncategorized = true;
    });
    this.categories = Array.from(categorySet).sort();
    if (hasUncategorized) this.categories.push('未分类');
    this.categoryCountCache = null;
  },
  updateCategoryView() {
    if (this.selectedCategory) {
      const categoryBooks = this.selectedCategory === '未分类'
        ? this.allBooks.filter(book => !book.localCategory)
        : this.allBooks.filter(book => book.localCategory === this.selectedCategory);
      this.categoryBooks = categoryBooks;
      this.currentModeList = categoryBooks;
    } else {
      if (!this.categoryCountCache) {
        const countMap = {};
        let uncategorizedCount = 0;
        for (let i = 0; i < this.allBooks.length; i++) {
          const book = this.allBooks[i];
          if (book.localCategory) {
            countMap[book.localCategory] = (countMap[book.localCategory] || 0) + 1;
          } else {
            uncategorizedCount++;
          }
        }
        this.categoryCountCache = {
          countMap,
          uncategorizedCount
        };
      }

      const categoryItems = this.categories.map(cat => ({
        isCategory: true,
        categoryName: cat,
        name: cat,
        bookCount: cat === '未分类'
          ? this.categoryCountCache.uncategorizedCount
          : (this.categoryCountCache.countMap[cat] || 0)
      }));
      this.currentModeList = this.withMoreFolder(this.lastReadBook ? [this.lastReadBook, ...categoryItems] : categoryItems);
    }

    if (this.categoryPagination) {
      this.loadPage(this.currentPage);
    } else {
      this.loadPage(0, this.currentModeList.length);
    }
  },
  async handleItemClick(item) {
    if (item.isFolder) {
      this.openMoreFolder();
    } else if (item.isCategory) {
      this.selectedCategory = item.categoryName;
      this.currentPage = 0;
      this.updateCategoryView();
    } else if (this.moreFolderOpen && !(await this.hasBookContent(item.dirName))) {
      // 「更多」里的残留记录大多没有正文，点开只会进空白页，先给个明确提示。
      prompt.showToast({ message: '只有阅读记录，正文没同步到手环', duration: 2000 });
    } else {
      this.selectFile(item);
    }
  },
  backToCategoryList() {
    this.currentPage = 0;

    if (this.moreFolderOpen) {
      this.moreFolderOpen = false;
      if (this.displayMode === 'category') {
        this.updateCategoryView();
      } else {
        this.currentModeList = this.withMoreFolder(this.allBooks);
        this.loadPage(0);
      }
      return;
    }

    this.selectedCategory = null;
    this.updateCategoryView();
  },
  getProgressSubtitle(book) {
    if (!book) return '暂无进度';
    if (book.isCategory || book.isFolder) return `共 ${book.bookCount || 0} 本`;
    
    const prefix = book.isLastRead ? '上次阅读 · ' : '';
    const progress = book.progress || {};
    if (progress.chapterIndex === null || progress.chapterIndex === undefined || progress.chapterIndex < 0) {
      return `${prefix}尚未开始`;
    }

    const round = (num) => {
        const p = parseFloat(num);
        return isNaN(p) ? '0.00' : p.toFixed(2);
    };

    const cacheKey = `${book.dirName || ''}|${book.isLastRead ? 1 : 0}|${this.homeProgressMode}|${book.chapterCount || 0}|${progress.chapterIndex}|${progress.chapterProgressPercent != null ? progress.chapterProgressPercent : ''}`;
    if (this.progressSubtitleCache && this.progressSubtitleCache[cacheKey]) {
      return this.progressSubtitleCache[cacheKey];
    }

    let result = '';
    if (this.homeProgressMode === 'chapter') {
      const chapterPercent = round(progress.chapterProgressPercent || 0);
      result = `${prefix}${chapterPercent}% · 本章进度`;
    } else {
      const totalChapters = parseInt(book.chapterCount, 10) || 0;
      if (totalChapters <= 0) {
        result = `${prefix}0.00% · 章节信息缺失`;
      } else {
        const chapterIndex = (typeof progress.chapterIndex === 'number' && progress.chapterIndex >= 0) ? progress.chapterIndex : 0;
        const chapterFraction = (Math.max(0, parseFloat(progress.chapterProgressPercent) || 0)) / 100;
        const progressValue = ((chapterIndex + chapterFraction) / totalChapters) * 100;
        const bookPercent = round(Math.min(100, Math.max(0, progressValue)));
        const currentChapter = Math.min(totalChapters, (progress.chapterIndex || 0) + 1);
        result = `${prefix}${bookPercent}% · 看到 ${currentChapter} / ${totalChapters} 章`;
      }
    }

    if (this.progressSubtitleCache) this.progressSubtitleCache[cacheKey] = result;
    return result;
  },
  loadPage(page, customPageSize) {
    const list = this.currentModeList || this.allBooks;
    const size = customPageSize || this.pageSize;
    this.totalPages = Math.ceil(list.length / size) || 1;
    const safePage = Math.max(0, Math.min(page, this.totalPages - 1));
    
    if (this.totalPages > 0) {
      const start = safePage * size;
      const end = start + size;
      const sliced = list.slice(start, end);
      this.visibleBooks = sliced.map(item => {
          const viewItem = Object.assign({}, item);
          viewItem.subtitle = (item.isCategory || item.isFolder) ? `共 ${item.bookCount || 0} 本` : this.getProgressSubtitle(item);
          return viewItem;
      });
      this.currentPage = safePage;
    } else {
      this.visibleBooks = [];
      this.currentPage = 0;
    }
  },
  prevPage() {
    if (this.currentPage > 0) this.loadPage(this.currentPage - 1);
  },
  nextPage() {
    if (this.currentPage < this.totalPages - 1) this.loadPage(this.currentPage + 1);
  },
  selectFile(item) {
    if (this.isNavigating || item.isCategory) return;
    this.isNavigating = true;
    globalThis.enteringDetailView = true;
    
    if (this.displayMode === 'category' && this.selectedCategory) {
      globalThis.fromCategoryPage = true;
      globalThis.selectedCategory = this.selectedCategory;
      globalThis.categoryPage = this.currentPage;
      globalThis.fromHomePage = false;
      globalThis.homePage = null;
    } else if (this.displayMode === 'all') {
      globalThis.fromCategoryPage = false;
      globalThis.selectedCategory = null;
      globalThis.fromHomePage = true;
      globalThis.homePage = this.currentPage;
    } else {
      globalThis.fromCategoryPage = false;
      globalThis.selectedCategory = null;
      globalThis.fromHomePage = false;
      globalThis.homePage = null;
    }
    
    router.push({ uri: '/pages/detail', params: { name: item.dirName } });
  },
	openSearch() {
		router.push({ uri: '/pages/search' });
	},
  routerTo(page) { router.push({ uri: `/pages/${page}` }); },
  loadDeviceInfo() {
    if (!this.showStorageWarning) { this.isStorageLow = false; return; }

    const now = Date.now();
    if (this.storageInfoLoaded && now - this.lastDeviceInfoTs < 30000) return;
    this.lastDeviceInfoTs = now;
    this.storageInfoLoaded = true;

    device.getInfo({
      success: (ret) => {
        device.getTotalStorage({
          success: (data) => {
            const totalStorage = data.totalStorage || 0;
            device.getAvailableStorage({
              success: (availData) => {
                const storageInfo = calculateStorageInfo(totalStorage, availData.availableStorage || 0, ret.product);
                this.isStorageLow = isStorageLow(storageInfo.actualAvailable);
              }
            });
          }
        });
      }
    });
  },
  getContentClass(item) {
      if (this.displayMode === 'category' && !this.selectedCategory && item.isCategory) return 'category-item-content';
      return 'category-item-content';
  }
};
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #000000;
}

.list {
  width: 192px;
  height: 490px;
  position: absolute;
  top: 0px;
  left: 0px;
  padding: 86px 12px;
}

.item {
  width: 100%;
  height: 85px;
  padding: 12px 18px;
  margin-bottom: 8px;
  background-color: #262626;
  border-radius: 26px;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
}
.search-item {
	height: 72px;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	background-color: #1f1f1f;
}
.search-content {
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	width: 100%;
}
.search-placeholder {
	font-size: 26px;
	line-height: 36px;
	color: rgba(255, 255, 255, 0.6);
}

.category-item-content {
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.itemtext {
  font-size: 23px;
  width: 100%;
  font-weight: bold;
  color: white;
  text-overflow: ellipsis;
  lines: 1;
}

.itemtext2 {
  font-size: 16px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  text-overflow: ellipsis;
  lines: 1;
}

.pagination-container {
  width: 100%;
  height: 80px;
  justify-content: center;
  align-items: center;
}

.pagination-controls {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding: 0 8px;
}

.pagination-button {
  width: 62px;
  height: 62px;
}

.pagination-text {
  font-size: 21px;
  font-weight: bold;
  color: white;
}
</style>
